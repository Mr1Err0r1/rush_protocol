allowed_item_categories = ["intel", "gadget"]
detection_resistance = 0.1
entry_bonus_id = &"bonus_clearance_level"
passive_ability_id = &"passive_counter_intel"
active_ability_id = &"active_extraction"
primary_objective = "survive_undetected"
unlocked_by_default = true
